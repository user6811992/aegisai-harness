{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AegisAi Harness",
  "version": "0.12.0",
  "identifier": "com.aegisai.harness",
  "build": {
    "frontendDist": "../../public",
    "beforeDevCommand": "node ../../src/index.js --web",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "AegisAi Harness",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
