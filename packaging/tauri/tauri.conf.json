{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AegisAi Harness",
  "version": "1.0.61",
  "identifier": "com.aegisai.harness",
  "build": {
    "frontendDist": "../../public",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "node ../../src/index.js --web",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AegisAi Harness",
        "url": "http://127.0.0.1:8080",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "AegisAi",
    "copyright": "Copyright (c) 2026 AegisAi",
    "icon": [
      "icons/icon.ico",
      "icons/icon-192.png",
      "icons/icon-512.png"
    ],
    "resources": {
      "../../src": "src",
      "../../public": "public",
      "../../scripts": "scripts",
      "../../package.json": "package.json",
      "../../README.md": "README.md",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

