{
  "name": "aegisai-harness",
  "version": "1.0.51",
  "description": "AegisAi Harness — feature-rich, local-only AI agent harness",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "aegisai-harness": "src/index.js",
    "aegisai": "src/index.js"
  },
  "files": [
    "src/",
    "public/",
    "packaging/",
    "scripts/",
    "README.md",
    "LICENSE",
    "ROADMAP.md",
    "CHANGELOG.md",
    "HARNESS_DOCS.md",
    "CONTRIBUTING.md",
    "llms.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node tests/run-tests.js",
    "lint": "node scripts/run-lint.js",
    "check:version": "node scripts/check-version-consistency.js"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "llms.txt",
      "THIRD_PARTY_NOTICES.md"
    ],
    "targets": [
      "node24-win-x64",
      "node24-linux-x64",
      "node24-macos-x64"
    ]
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {},
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0",
    "pdf-parse": "^1.1.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user6811992/aegisai-harness.git"
  },
  "homepage": "https://github.com/user6811992/aegisai-harness",
  "bugs": {
    "url": "https://github.com/user6811992/aegisai-harness/issues"
  },
  "author": {
    "name": "AegisAi",
    "url": "https://github.com/user6811992"
  }
}
